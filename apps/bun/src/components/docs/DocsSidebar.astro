---
import type { DocTreeNode } from "emdash";
import DocsSidebarNode from "./DocsSidebarNode.astro";

interface Props {
	tree: DocTreeNode[];
	activePath: string;
	prefix: string;
	versionLabel?: string;
}

const { tree, activePath, prefix, versionLabel } = Astro.props;
---

<nav class="docs-sidebar" aria-label="Documentation">
	<div class="docs-sidebar-head">
		<p class="docs-kicker">Docs{versionLabel ? ` · ${versionLabel}` : ""}</p>
		<button type="button" class="docs-mobile-close" data-docs-close aria-label="Close sidebar">
			✕
		</button>
	</div>
	{
		tree.length === 0 ? (
			<p class="docs-empty">No published docs in this version.</p>
		) : (
			<ul class="docs-tree">
				{tree.map((node) => (
					<DocsSidebarNode node={node} activePath={activePath} prefix={prefix} />
				))}
			</ul>
		)
	}
</nav>

<script>
	function bindSidebar(root: ParentNode = document) {
		root.querySelectorAll<HTMLButtonElement>("[data-docs-twist]").forEach((btn) => {
			if (btn.dataset.bound === "1") return;
			btn.dataset.bound = "1";
			btn.addEventListener("click", () => {
				const id = btn.getAttribute("aria-controls");
				const kids = id ? document.getElementById(id) : null;
				const open = btn.getAttribute("aria-expanded") === "true";
				btn.setAttribute("aria-expanded", open ? "false" : "true");
				if (kids) kids.hidden = open;
				btn.closest(".docs-node")?.classList.toggle("is-open", !open);
			});
		});
	}

	bindSidebar();
	document.addEventListener("astro:page-load", () => bindSidebar());
</script>

<style>
	.docs-sidebar {
		font-size: var(--font-size-sm);
	}

	.docs-sidebar-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--spacing-3);
	}

	.docs-kicker {
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.docs-mobile-close {
		display: none;
		border: 0;
		background: transparent;
		color: var(--color-muted);
		font-size: 1rem;
		cursor: pointer;
	}

	.docs-empty {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.docs-tree {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (max-width: 900px) {
		.docs-mobile-close {
			display: inline-flex;
		}
	}
</style>
