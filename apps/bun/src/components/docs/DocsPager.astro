---
import type { DocNeighbors } from "emdash";
import { docsHref } from "../../utils/docs";

interface Props {
	neighbors: DocNeighbors;
	prefix: string;
}

const { neighbors, prefix } = Astro.props;
---

<nav class="docs-pager" aria-label="Adjacent pages">
	{
		neighbors.prev ? (
			<a class="docs-pager-link is-prev" href={docsHref(prefix, neighbors.prev.path)}>
				<span class="docs-pager-dir">Previous</span>
				<span class="docs-pager-title">{neighbors.prev.title}</span>
			</a>
		) : (
			<span />
		)
	}
	{
		neighbors.next ? (
			<a class="docs-pager-link is-next" href={docsHref(prefix, neighbors.next.path)}>
				<span class="docs-pager-dir">Next</span>
				<span class="docs-pager-title">{neighbors.next.title}</span>
			</a>
		) : (
			<span />
		)
	}
</nav>

<style>
	.docs-pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-4);
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border);
	}

	.docs-pager-link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: var(--spacing-4);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: inherit;
		background: var(--color-bg-subtle);
		transition:
			border-color var(--transition-fast),
			background var(--transition-fast);
	}

	.docs-pager-link:hover {
		border-color: var(--color-accent);
		background: var(--color-surface);
	}

	.docs-pager-link.is-next {
		text-align: right;
		align-items: flex-end;
	}

	.docs-pager-dir {
		font-size: var(--font-size-xs);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.docs-pager-title {
		font-size: var(--font-size-base);
		font-weight: 600;
		color: var(--color-text);
	}

	@media (max-width: 600px) {
		.docs-pager {
			grid-template-columns: 1fr;
		}

		.docs-pager-link.is-next {
			text-align: left;
			align-items: flex-start;
		}
	}
</style>
