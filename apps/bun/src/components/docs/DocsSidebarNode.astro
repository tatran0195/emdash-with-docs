---
import type { DocTreeNode } from "emdash";
import { docsHref } from "../../utils/docs";

interface Props {
	node: DocTreeNode;
	activePath: string;
	prefix: string;
	depth?: number;
}

const { node, activePath, prefix, depth = 0 } = Astro.props;
const href = docsHref(prefix, node.path);
const isActive = node.path === activePath;
const isAncestor = activePath === node.path || activePath.startsWith(`${node.path}/`);
const hasChildren = node.children.length > 0;
const isSection = node.kind === "section";
---

<li class:list={["docs-node", { "is-section": isSection, "is-active": isActive, "is-open": isAncestor }]}>
	<div class="docs-row" style={`--depth: ${depth}`}>
		{
			hasChildren ? (
				<button
					type="button"
					class="docs-twist"
					aria-expanded={isAncestor ? "true" : "false"}
					aria-controls={`docs-kids-${node.id}`}
					data-docs-twist
				>
					<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
						<path
							d="M6 4l4 4-4 4"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</button>
			) : (
				<span class="docs-twist is-leaf" aria-hidden="true"></span>
			)
		}
		<a
			href={href}
			class="docs-link"
			aria-current={isActive ? "page" : undefined}
			title={node.title}
		>
			{
				isSection && (
					<svg class="docs-folder" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
						<path
							d="M2 4.5A1.5 1.5 0 0 1 3.5 3h3l1 1.25H12.5A1.5 1.5 0 0 1 14 5.75v5.75A1.5 1.5 0 0 1 12.5 13h-9A1.5 1.5 0 0 1 2 11.5v-7Z"
							fill="currentColor"
							opacity="0.85"></path>
					</svg>
				)
			}
			<span class="docs-title">{node.title}</span>
		</a>
	</div>
	{
		hasChildren && (
			<ul
				id={`docs-kids-${node.id}`}
				class="docs-kids"
				hidden={!isAncestor}
			>
				{node.children.map((child) => (
					<Astro.self node={child} activePath={activePath} prefix={prefix} depth={depth + 1} />
				))}
			</ul>
		)
	}
</li>

<style>
	.docs-node {
		list-style: none;
	}

	.docs-row {
		display: flex;
		align-items: center;
		gap: 2px;
		padding-inline-start: calc(var(--depth) * 0.85rem);
		border-radius: var(--radius);
	}

	.docs-twist {
		flex: 0 0 20px;
		width: 20px;
		height: 24px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		border-radius: var(--radius);
	}

	.docs-twist:hover {
		color: var(--color-text);
		background: var(--color-surface);
	}

	.docs-twist.is-leaf {
		cursor: default;
	}

	.docs-node.is-open > .docs-row > .docs-twist svg {
		transform: rotate(90deg);
	}

	.docs-twist svg {
		transition: transform var(--transition-fast);
	}

	.docs-link {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		min-width: 0;
		flex: 1;
		padding: 0.28rem 0.45rem;
		border-radius: var(--radius);
		color: var(--color-text-secondary);
		text-decoration: none;
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
	}

	.docs-link:hover {
		color: var(--color-text);
		background: var(--color-surface);
	}

	.docs-node.is-active > .docs-row > .docs-link {
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		font-weight: 600;
	}

	.docs-folder {
		flex-shrink: 0;
		color: var(--color-muted);
	}

	.docs-node.is-active > .docs-row .docs-folder {
		color: var(--color-accent);
	}

	.docs-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.docs-kids {
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
